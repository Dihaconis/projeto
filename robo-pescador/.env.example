# Copie este arquivo para .env e preencha. NUNCA envie o .env para o GitHub.

# --- Cérebro (roteiro e textos) ---
# Chave gratuita em https://aistudio.google.com/apikey (só precisa de conta Google)
GEMINI_API_KEY=
# Modelos tentados em ordem; se um bater o limite gratuito, passa para o próximo
GEMINI_MODELOS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest

# --- Imagens ---
# Opcional. Sem token funciona, mas mais devagar (1 imagem a cada ~15 s) e pode ter marca d'água.
# Token gratuito em https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# De onde vêm as imagens:
#   pollinations = automático, grátis, qualidade fraca
#   colab        = o robô deixa um pedido no Google Drive, você roda o caderno
#                  "gerador_imagens_pescador" no Colab e depois: rodar.bat --continuar
IMAGENS_ORIGEM=pollinations
# Pasta robo-pescador dentro do Google Drive para computador (só com colab)
PASTA_DRIVE=G:\Meu Drive\robo-pescador

# 1 = depois das imagens, o robô deixa no Drive (clipes/EP-...) um kit para animar
#     no Google Flow e para uma vez. Rode --continuar quando os clipes estiverem lá.
ANIMAR=0

# --- Voz ---
VOZ_NARRADOR=pt-BR-AntonioNeural
VELOCIDADE_VOZ=-6%

# --- Aviso no celular (Telegram) ---
# 1) No Telegram, fale com @BotFather, mande /newbot e copie o token
# 2) Mande qualquer mensagem para o seu bot e abra:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> copie o "chat":{"id": ...}
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Montagem ---
# Opcional: caminho de um MP3 livre de direitos (ex.: Biblioteca de áudio do YouTube)
MUSICA_FUNDO=
PASTA_SAIDA=saida

# 1 = roda sem internet, com imagens e voz falsas (para testar a montagem)
MODO_TESTE=0
